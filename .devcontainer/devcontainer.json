{
  "name": "lambda-cpp26-dev",
  "image": "ghcr.io/arekglinka/lambda_cpp26-dev:latest",
  "shutdownAction": "none",
  "runArgs": [
    "--device=/dev/dxg",
    "--mount=type=bind,src=/usr/lib/wsl,dst=/usr/lib/wsl,readonly"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/var/lang/bin/python3",
        "python.analysis.extraPaths": [
          "${workspaceFolder}/build/Release"
        ],
        "clangd.arguments": [
          "--compile-commands-dir=${workspaceFolder}/build/Release",
          "--query-driver=/opt/gcc16/bin/g++",
          "-j=4"
        ],
        "clangd.path": "/var/lang/bin/clangd",
        "C_Cpp.default.compilerPath": "/opt/gcc16/bin/g++",
        "C_Cpp.default.cppStandard": "c++26",
        "cmake.configureOnOpen": false,
        "editor.formatOnSave": false
      }
    }
  },
  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}/build/Release:${containerWorkspaceFolder}"
  },
  "remoteUser": "root"
}
