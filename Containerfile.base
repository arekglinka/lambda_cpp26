# Single source of truth for the shared toolchain base image.
# Consumed by:
#   - deployment builds (Containerfile builder stage, via BASE_TAG)
#   - devcontainer builds (thin .devcontainer/Dockerfile, via BASE_TAG)
#
# CI tags each stage separately so unchanged stages are pulled, not rebuilt:
#   :<hash>-toolchain  dnf packages + GCC (rarely changes, ~30 min)
#   :<hash>-python     pip stack incl. torch (~3 GB download, changes rarely)
#   :<hash>            + conan dependency prebuild (changes with recipes)
#   :<hash>-agents    bun + omo agent CLI (https://omo.dev)
#
# NOTE: dnf python3-devel is intentionally absent — the Lambda base ships
# CPython headers under /var/lang/include, which CMake's FindPython picks up.
FROM public.ecr.aws/lambda/python:3.13 AS toolchain

ARG GCC_VERSION=16.2.0

RUN dnf install -y \
        gcc gcc-c++ binutils git \
        tar xz bzip2 ca-certificates ncurses-devel which curl-devel \
        gmp-devel mpfr-devel libmpc-devel isl-devel \
        bison flex texinfo wget diffutils \
        perl perl-FindBin \
        zlib-devel openssl-devel \
    && dnf clean all

RUN mkdir -p /tmp/gcc && cd /tmp/gcc && \
    curl -sL "https://gcc.gnu.org/pub/gcc/releases/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.xz" | \
    tar xJ --strip-components=1 && \
    ./contrib/download_prerequisites && mkdir build && cd build && \
    ../configure --prefix=/opt/gcc16 \
        --enable-languages=c,c++ --disable-multilib \
        --disable-bootstrap --disable-nls --enable-checking=release && \
    make -j"$(nproc)" && make install && rm -rf /tmp/gcc

ENV CC=/opt/gcc16/bin/gcc
ENV CXX=/opt/gcc16/bin/g++
ENV PATH="/opt/gcc16/bin:${PATH}"
# WSL devcontainers bind-mount /usr/lib/wsl with the NVIDIA driver libs;
# absent on other hosts, ignored by the dynamic linker.
ENV LD_LIBRARY_PATH="/usr/lib/wsl/lib:/opt/gcc16/lib64:${LD_LIBRARY_PATH}"
ENV CFLAGS="-std=gnu17"
ENV CXXFLAGS=""

FROM toolchain AS python-stack

ARG TORCH_CUDA_INDEX=cu130
RUN pip3.13 install --no-cache-dir "numpy>=2.5" && \
    pip3.13 install --no-cache-dir torch \
        --index-url "https://download.pytorch.org/whl/${TORCH_CUDA_INDEX}"

RUN pip3.13 install --no-cache-dir \
    "conan>=2.32" "cmake>=4.4" "ninja>=1.13" \
    "pybind11>=3.1" "pyarrow>=25" "pytest>=9" \
    "clangd>=22"

FROM python-stack AS conan-deps

WORKDIR /src

COPY profiles/ /tmp/conan-profiles/
COPY recipes/ /tmp/recipes/
COPY conanfile.py ./

RUN conan remote add conancenter https://center2.conan.io --force 2>/dev/null || true && \
    conan export /tmp/recipes/arrow && \
    conan export /tmp/recipes/quantlib

ARG BUILD_TYPE=Release
RUN conan install . --build=missing \
        -pr:h /tmp/conan-profiles/al2023 \
        -pr:b /tmp/conan-profiles/al2023 \
        -s:h build_type=${BUILD_TYPE}
FROM conan-deps AS agents
# e2e-cache-granularity-probe 2026-09-29T10:40Z

# https://omo.dev — bun runtime + omo agent CLI
RUN dnf install -y unzip && dnf clean all && \
    curl -fsSL https://github.com/oven-sh/bun/releases/latest/download/bun-linux-x64.zip -o /tmp/bun.zip && \
    unzip -q /tmp/bun.zip -d /tmp && \
    mv /tmp/bun-linux-x64/bun /usr/local/bin/bun && \
    rm -rf /tmp/bun.zip /tmp/bun-linux-x64 && \
    bun install -g omo-ai && \
    for f in /root/.bun/bin/*; do [ -f "$f" ] || continue; head -1 "$f" 2>/dev/null | grep -q "env node" || continue; sed --follow-symlinks -i "1s|.*|#!/usr/bin/env bun|" "$f"; done

ENV PATH="/root/.bun/bin:${PATH}"

