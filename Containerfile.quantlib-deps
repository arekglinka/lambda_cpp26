# Containerfile.quantlib-deps
# =============================================================================
# Builds ONLY QuantLib 1.38 (+ boost, header-only) into the Conan cache.
# Independent of Containerfile.arrow-deps — the two can build in parallel.
#
# Cache key (in devcontainer.yml): hash of recipes/quantlib/* + profiles/al2023 +
# conanfile.py + the gcc-base tag. Any quantlib recipe change rebuilds this
# image but leaves arrow-deps and gcc-base untouched.
# =============================================================================
ARG REGISTRY_OWNER=arekglinka
ARG GCC_TAG=latest
FROM ghcr.io/${REGISTRY_OWNER}/lambda_cpp26-gcc-base:${GCC_TAG}

COPY recipes/quantlib/ /tmp/recipes/quantlib/
COPY profiles/al2023   /tmp/conan-profiles/al2023
COPY conanfile.py      /tmp/conanfile.py

WORKDIR /tmp

RUN conan remove 'quantlib/*' --force 2>/dev/null || true && \
    conan export /tmp/recipes/quantlib && \
    conan install "quantlib/1.38" \
        --build=missing \
        -pr:h /tmp/conan-profiles/al2023 \
        -pr:b /tmp/conan-profiles/al2023 \
        -s:h build_type=Release && \
    conan list 'quantlib/*' --cache
