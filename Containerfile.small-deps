# Containerfile.small-deps
# =============================================================================
# Builds ALL transitive deps of the project (boost, lz4, zstd, snappy, zlib,
# thrift, openssl, abseil, re2, brotli, rapidjson, utf8proc, libevent, etc.)
# but NOT arrow or quantlib themselves.
#
# Cache key (in devcontainer.yml): hash of small-deps-conanfile.py + profiles/al2023
# + the gcc-base tag. Any change to transitive deps versions rebuilds this image
# but leaves gcc-base cached.
#
# Both Containerfile.arrow and Containerfile.quantlib FROM this image, which
# guarantees their conan caches share IDENTICAL transitives — making the merge
# in the assemble step conflict-free.
# =============================================================================
ARG REGISTRY_OWNER=arekglinka
ARG GCC_TAG=latest
FROM ghcr.io/${REGISTRY_OWNER}/lambda_cpp26-gcc-base:${GCC_TAG}

COPY small-deps-conanfile.py /tmp/small-deps-conanfile.py
COPY profiles/al2023          /tmp/conan-profiles/al2023
COPY recipes/                 /tmp/recipes/

WORKDIR /tmp

# Install transitives only. The small-deps-conanfile.py omits arrow/quantlib
# so they're not built here — leaves them for the parallel arrow/quantlib jobs.
RUN conan install /tmp/small-deps-conanfile.py \
        --build=missing \
        -pr:h /tmp/conan-profiles/al2023 \
        -pr:b /tmp/conan-profiles/al2023 \
        -s:h build_type=Release
