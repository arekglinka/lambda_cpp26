{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-active-cpp",
            "detail": "Build the C++ file in the active editor (learn/ or src/)",
            "type": "shell",
            "command": "./learn/build.sh",
            "args": [
                "${relativeFile}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "run-active-cpp",
            "detail": "Build + run the active C++ file in terminal (no debugger)",
            "type": "shell",
            "command": "${workspaceFolder}/build/${relativeFileDirname}/${fileBasenameNoExtension}",
            "dependsOn": "build-active-cpp",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "build-active-standalone-only",
            "detail": "Pre-launch build for standalone-executable launch configs; errors clearly if active file is a pybind11 module",
            "type": "shell",
            "command": "if grep -q 'PYBIND11_MODULE(' \"${file}\"; then echo ''; echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'; echo ''; echo '  ${relativeFile} is a pybind11 Python module, not a standalone executable.'; echo '  It builds to a .so that Python imports — there is no binary to launch.'; echo ''; echo '  To debug it, switch the launch config:'; echo '    1. Open Run & Debug panel (Ctrl+Shift+D)'; echo '    2. Click the dropdown at the top (currently shows this config name)'; echo '    3. Pick: \"Debug pytest (sum_columns module)\"'; echo '    4. Press F5'; echo ''; echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'; echo ''; exit 1; fi && ./learn/build.sh '${relativeFile}'",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "build-sum-columns",
            "detail": "Rebuild the pybind11 .so via Conan's CMake (incremental)",
            "type": "shell",
            "command": "make",
            "args": [
                "-C",
                "build/Release",
                "sum_columns",
                "-j$(nproc)"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
