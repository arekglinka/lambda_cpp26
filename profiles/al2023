# Conan 2.x host profile for Amazon Linux 2023 (AWS Lambda runtime).
#
# Usage:
#   conan install . --profile=profiles/al2023 --build=missing
#
# AL2023 ships GCC 14 by default.  The Containerfile installs GCC 16;
# override at build time:
#   conan install . --profile=profiles/al2023 \
#       -s compiler.version=16 -s compiler.cppstd=26

[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=16
compiler.cppstd=26
    compiler.libcxx=libstdc++11
    build_type=Release

[conf]
# Parallel compilation jobs.
tools.build:jobs=8

# Section-level GC flags for selective static linking.
# Arrow and QuantLib produce large archives; -ffunction-sections +
# -fdata-sections emit per-function data, and the consumer's
# -Wl,--gc-sections linker flag discards unreferenced symbols.
tools.build:cflags=["-ffunction-sections", "-fdata-sections", "-Wno-error=implicit-function-declaration", "-Wno-error=int-conversion"]
tools.build:cxxflags=["-ffunction-sections", "-fdata-sections"]
tools.build:exelinkflags=["-Wl,--gc-sections", "-Wl,--as-needed"]
tools.build:sharedlinkflags=["-Wl,--gc-sections", "-Wl,--as-needed"]

[buildenv]
CMAKE_BUILD_TYPE=Release
LDFLAGS=-Wl,--gc-sections -Wl,--as-needed
