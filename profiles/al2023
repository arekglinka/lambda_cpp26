# Conan 2.x host profile for Amazon Linux 2023 (AWS Lambda runtime).
#
# Usage:
#   conan install . --profile=profiles/al2023 --build=missing
#
# Architecture is intentionally OMITTED so Conan 2 auto-detects it from the
# builder container's native platform (x86_64 on amd64 runners, aarch64 on
# arm64/Graviton runners). This lets a single profile drive BOTH Lambda
# function + MicroVM image builds for both architectures — each builder
# container is spun up with `podman build --platform linux/<arch>` and runs
# GCC 16 natively, so Conan resolves arch from the build environment. Do NOT
# pin `arch=` here or every arm64 build would try to reuse x86_64 binaries
# from the cache and fail at link time.

[settings]
os=Linux
compiler=gcc
compiler.version=16
compiler.cppstd=17
compiler.libcxx=libstdc++11
build_type=Release

[options]
# Arrow modules the recipe defaults to ON but Lambda does not need.
# Python (PyArrow) handles all cloud I/O; the C++ extension is pure compute.
arrow/*:gandiva=False
arrow/*:flight=False
arrow/*:flight_sql=False
arrow/*:s3=False
arrow/*:orc=False

[conf]
tools.build:jobs=8

# Section-level GC flags for selective static linking.
# Arrow and QuantLib produce large archives; -ffunction-sections +
# -fdata-sections emit per-function data, and the consumer's
# -Wl,--gc-sections linker flag discards unreferenced symbols.
tools.build:cflags=["-ffunction-sections", "-fdata-sections", "-Wno-error=implicit-function-declaration", "-Wno-error=int-conversion"]
tools.build:cxxflags=["-ffunction-sections", "-fdata-sections"]
tools.build:exelinkflags=["-Wl,--gc-sections", "-Wl,--as-needed"]
tools.build:sharedlinkflags=["-Wl,--gc-sections", "-Wl,--as-needed"]

[buildenv]
CMAKE_BUILD_TYPE=Release
LDFLAGS=-Wl,--gc-sections -Wl,--as-needed
