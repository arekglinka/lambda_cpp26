# Containerfile.deps
# =============================================================================
# Combined Conan dependency build for both Apache Arrow and QuantLib (+ all
# transitive deps). Built by the deps job in .github/workflows/devcontainer.yml,
# cached on ghcr.io by content hash.
#
# Why combined (not split into arrow-deps + quantlib-deps in parallel):
# Conan's dependency resolution requires consumer-side directives
# (`override=True` for boost version pin, `options={...}` for arrow's
# csv/json/etc.) that only apply when installing FROM a conanfile.py.
# Installing via `conan install --requires=arrow/18.0.0` from CLI produces
# a DIFFERENT binary variant (recipe defaults) than the project needs —
# merging would trigger a full rebuild. Single combined install from the
# project conanfile.py is the only correct path.
#
# Cache key (in devcontainer.yml): hash of recipes/* + profiles/al2023 +
# conanfile.py + the gcc-base tag. Any recipe change rebuilds this image
# (~50 min cold) but leaves gcc-base cached.
#
# No --mount=type=cache here: we WANT the binaries baked INTO the image
# layer so the assembled dev/prod image can COPY them. Cross-CI cache reuse
# happens via the content-hash image tagging on ghcr.io.
# =============================================================================
ARG REGISTRY_OWNER=arekglinka
ARG GCC_TAG=latest
FROM ghcr.io/${REGISTRY_OWNER}/lambda_cpp26-gcc-base:${GCC_TAG}

COPY recipes/      /tmp/recipes/
COPY profiles/     /tmp/conan-profiles/
COPY conanfile.py  /tmp/conanfile.py

WORKDIR /tmp

# `conan remove` first to invalidate stale recipe revisions inherited from
# gcc-base's recipe export step (see docs/learning-path.md Q47). Then install
# from the root conanfile.py — this applies ALL consumer options (arrow's
# csv/json=False, boost/1.90.0 override=True) and produces the exact binary
# variants the project expects.
RUN conan remove 'arrow/*'     --force 2>/dev/null || true && \
    conan remove 'quantlib/*'  --force 2>/dev/null || true && \
    conan export /tmp/recipes/arrow && \
    conan export /tmp/recipes/quantlib && \
    conan install /tmp/conanfile.py \
        --build=missing \
        -pr:h /tmp/conan-profiles/al2023 \
        -pr:b /tmp/conan-profiles/al2023 \
        -s:h build_type=Release && \
    conan list 'arrow/*'    --cache && \
    conan list 'quantlib/*' --cache
